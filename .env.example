# ==============================================================================
# ContractMind API (Advotech Copilot Backend) - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the repository root: `cp .env.example .env`
# 2. Fill in the required credentials and database URLs.
# 3. NEVER commit real secret values, API keys, or database credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Set to "production" in production environments (Render, VPS, HF Spaces).
# In production, setting a strong custom SECRET_KEY is strictly enforced at boot.
ENVIRONMENT=development
# Secret key for JWT signing (HS256). In production, generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=temporary-fallback-secret-key-change-in-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public URLs used for SSLCommerz POST callbacks & frontend redirects
# Local dev: http://localhost:7860 and http://localhost:3000
# Production: https://legal-copilot-backend-088i.onrender.com and https://advotech-copilot.vercel.app
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Storage Configuration (Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Supabase AsyncPG format)
# Note: For Supabase PgBouncer transaction pooling, ensure port 6543 or 5432 is used.
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your_project.supabase.co:5432/postgres

# Supabase Storage & Service API (used for storing contract docs and lawyer proofs)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. Qdrant Cloud Vector Database
# ------------------------------------------------------------------------------
# Cluster URL (e.g. https://xxxxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333)
QDRANT_URL=https://your_qdrant_cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=bd_laws_e5_small
EMBED_MODEL=intfloat/multilingual-e5-small

# Optional Hugging Face Token (for private models or higher rate limits)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 4. LLM Providers (Multi-Tier Resilient Waterfall Chain)
# ------------------------------------------------------------------------------
# Primary Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_SECONDARY_MODEL=gemini-3-flash-preview
GEMINI_TERTIARY_MODEL=gemini-3.1-flash-lite

# Mid-Tier Resilient Provider: Z.AI (Zhipu AI / GLM OpenAI-compatible API)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-4.5-flash
ZAI_DISABLE_THINKING=true

# Fallback Provider: Groq (Ultra-low latency Qwen 2.5)
GROQ_API_KEY=your_groq_api_key
GROQ_MAX_TOKENS=950

# Active Primary LLM selector ("gemini", "zai", or "groq")
PRIMARY_LLM=gemini

# Google OAuth 2.0 Client ID (for verifying frontend Google login tokens)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 5. Search Providers & FastMCP Server
# ------------------------------------------------------------------------------
# Tavily API Key for live Bangladesh gazette & legal judgment search
TAVILY_API_KEY=your_tavily_api_key

# Standalone FastMCP 2.0 Server Endpoint (Streamable HTTP / SSE)
MCP_SERVER_URL=https://bd-legal-mcp-server.onrender.com/mcp
MCP_TOOL_TIMEOUT_S=40

# ------------------------------------------------------------------------------
# 6. Payment Gateway Configuration (SSLCommerz)
# ------------------------------------------------------------------------------
# Register free sandbox at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Legacy bKash manual reference merchant number
BKASH_MERCHANT_NUMBER=01700000000

# ------------------------------------------------------------------------------
# 7. Security, Rate Limiting & Upload Caps
# ------------------------------------------------------------------------------
# OTP brute force lockout (SEC-AUTH-01)
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# Upload file size caps in MB (SEC-DOS-01)
MAX_CONTRACT_UPLOAD_MB=20
MAX_PROOF_UPLOAD_MB=10
MAX_AVATAR_UPLOAD_MB=5

# ------------------------------------------------------------------------------
# 8. Email Notifications (Gmail API or SMTP)
# ------------------------------------------------------------------------------
# Leave blank to use local fallback logging (demo_emails.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@advotech.ai
GMAIL_SENDER=
