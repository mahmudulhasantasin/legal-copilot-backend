# Copy to .env and fill in values (never commit real secrets)

# SSLCommerz Payment Gateway (register free sandbox at https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=your_sandbox_store_id
SSLCOMMERZ_STORE_PASSWD=your_sandbox_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Public URLs used for SSLCommerz POST callbacks & frontend redirects
# Local dev: http://localhost:7860 and http://localhost:3000
# Production: https://legal-copilot-backend-npq7.onrender.com and https://outliers-omega.vercel.app
BACKEND_PUBLIC_URL=http://localhost:7860
FRONTEND_URL=http://localhost:3000
